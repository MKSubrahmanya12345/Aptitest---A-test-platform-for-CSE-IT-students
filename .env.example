# OPTIONAL MySQL / non-demo deployment settings. Spring does not load .env automatically.
# Export these in your shell/IDE, or explicitly source a private .env copy.
# Never use example passwords for real accounts. Default H2 demo needs none of these.
SPRING_PROFILES_ACTIVE=mysql
DB_URL='jdbc:mysql://localhost:3306/aptitest_java?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC'
DB_USERNAME=aptitest
DB_PASSWORD='replace-with-your-database-password'
ADMIN_EMAIL='admin@example.com'
ADMIN_PASSWORD='replace-with-a-strong-unique-password'
APP_DEMO_ENABLED=false
APP_SEED_ENABLED=false
APP_BASE_URL='https://your-domain.example'
APP_MAIL_MODE=sendgrid
APP_MAIL_FROM='verified-sender@your-domain.example'
SENDGRID_API_KEY=''
APP_PAYMENT_MODE=disabled
RAZORPAY_KEY_ID=''
RAZORPAY_KEY_SECRET=''
COOKIE_SECURE=true
PORT=8080
