# Optional environment-variable configuration. Spring does not load .env automatically.
DB_URL='jdbc:mysql://localhost:3306/aptitest_java?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC'
DB_USERNAME=root
DB_PASSWORD='YOUR_MYSQL_PASSWORD'
APP_SEED_ENABLED=true
APP_MAIL_MODE=outbox
APP_PAYMENT_MODE=disabled
APP_BASE_URL='http://localhost:8080'
