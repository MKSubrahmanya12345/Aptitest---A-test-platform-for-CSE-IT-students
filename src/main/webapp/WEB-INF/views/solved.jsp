<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Solved questions"><div class="page-heading"><div><span class="greeting">KEEP THE LEARNING CLOSE</span><h1>Your solved question bank</h1><p>Revisit questions you answered in submitted tests. The latest answer to each question is shown.</p></div><span class="section-index">${total} unique questions</span></div>
<form class="filters" method="get" action="${ctx}/solved"><input type="search" name="search" value="<c:out value='${search}'/>" placeholder="Search your attempted questions" aria-label="Search questions"><select name="category" aria-label="Category"><option value="">All topics</option><c:forEach items="${categories}" var="cat"><option value="<c:out value='${cat}'/>" ${category == cat ? 'selected' : ''}><c:out value="${cat}"/></option></c:forEach></select><button type="submit" class="btn">Filter</button></form>
<c:choose><c:when test="${empty solved}"><section class="panel empty-state"><t:icon name="book"/><h3>No questions here yet.</h3><p>Answer a few questions and submit your first practice test, or try a different search.</p></section></c:when><c:otherwise><c:forEach items="${solved}" var="item"><%@ include file="fragments/review-question.jspf" %></c:forEach></c:otherwise></c:choose>
<div class="pagination"><span>Page ${page+1} of ${pages}</span><div><c:if test="${page > 0}"><c:url var="prev" value="/solved"><c:param name="page" value="${page-1}"/><c:param name="search" value="${search}"/><c:param name="category" value="${category}"/></c:url><a class="btn btn-secondary btn-small" href="<c:out value='${prev}'/>">← Previous</a></c:if><c:if test="${page+1 < pages}"><c:url var="next" value="/solved"><c:param name="page" value="${page+1}"/><c:param name="search" value="${search}"/><c:param name="category" value="${category}"/></c:url><a class="btn btn-secondary btn-small" href="<c:out value='${next}'/>">Next →</a></c:if></div></div>
</t:layout>
