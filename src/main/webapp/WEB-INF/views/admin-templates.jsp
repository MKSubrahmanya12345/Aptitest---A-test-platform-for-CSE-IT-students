<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Test templates"><div class="page-heading"><div><span class="greeting">PRACTICE, BY DESIGN</span><h1>Build the right kind of test.</h1><p>Choose the scope, pace, and difficulty of each practice experience.</p></div><a class="btn" href="${ctx}/admin/test-templates/new">+ Create template</a></div>
<%@ include file="fragments/notices.jspf" %>
<section class="panel"><c:choose><c:when test="${empty templates}"><div class="empty-state"><h3>Your first test is waiting to be built.</h3><p>Create a template and activate it to make it available to students.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Template</th><th>Difficulty</th><th>Questions / available</th><th>Time</th><th>Access</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach items="${templates}" var="test"><tr><td><span class="cell-title"><c:out value="${test.name}"/></span><span class="cell-subtitle">${test.allowReattempt ? 'Reattempts allowed' : 'No reattempts'}</span></td><td><c:out value="${test.difficulty}"/></td><td><span class="${available[test.id] lt test.questionCount ? 'pill pill-red' : ''}">${test.questionCount} / ${available[test.id]}</span></td><td>${test.durationMinutes} min</td><td>${test.paid ? test.priceDisplay : 'Free'}</td><td><span class="pill ${test.active ? '' : 'pill-muted'}">${test.active ? 'Active' : 'Archived'}</span></td><td><div class="table-actions"><a class="btn btn-secondary btn-small" href="${ctx}/admin/test-templates/${test.id}/edit">Edit</a><c:if test="${test.active}"><form method="post" action="${ctx}/admin/test-templates/${test.id}/archive" data-confirm="Archive this template? Existing results and payment history will be kept."><t:csrf/><button class="btn btn-secondary btn-small" type="submit">Archive</button></form></c:if></div></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section><p class="field-help" style="margin-top:16px">Templates are archived instead of deleted so that test history and payment references remain intact. Red availability counts mean more matching approved questions are needed.</p></t:layout>
