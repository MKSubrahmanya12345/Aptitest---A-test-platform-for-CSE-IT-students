<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Test history">
    <div class="page-heading"><div><span class="greeting">EVERY ATTEMPT IS A STEP FORWARD</span><h1>Your practice history</h1><p>Review your answers, learn from mistakes, or try a test again.</p></div><a class="btn" href="${ctx}/dashboard#practice">Start a new test <t:icon name="arrow"/></a></div>
    <%@ include file="fragments/notices.jspf" %>
    <section class="panel"><c:choose><c:when test="${empty history.content}"><div class="empty-state"><t:icon name="clock"/><h3>No attempts yet.</h3><p>Your completed tests and saved sessions will appear here.</p><a class="btn btn-soft" href="${ctx}/dashboard">Explore practice tests</a></div></c:when><c:otherwise>
    <div class="table-wrap"><table><thead><tr><th>Test</th><th>Started (IST)</th><th>Score</th><th>Correct / wrong / skipped</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${history.content}" var="a"><tr><td><span class="cell-title"><c:out value="${a.templateName}"/></span><c:if test="${a.reattempt}"><span class="cell-subtitle">Revision reattempt · excluded from stats</span></c:if></td><td>${a.displayDate}</td><td>${a.completed ? a.percentage : '—'}${a.completed ? '%' : ''}</td><td>${a.completed ? a.correctCount : '—'} / ${a.completed ? a.wrongCount : '—'} / ${a.completed ? a.skippedCount : '—'}</td><td><span class="pill ${a.completed ? '' : 'pill-amber'}">${a.completed ? 'Completed' : 'In progress'}</span></td><td><a class="btn btn-secondary btn-small" href="${ctx}/tests/${a.id}${a.completed ? '/result' : ''}">${a.completed ? 'Review result' : 'Resume'}</a></td></tr></c:forEach></tbody></table></div>
    <div class="pagination"><span>${history.totalElements} attempts · Page ${history.number + 1} of ${history.totalPages}</span><div><c:if test="${not history.first}"><a class="btn btn-secondary btn-small" href="${ctx}/history?page=${history.number - 1}">← Previous</a></c:if><c:if test="${not history.last}"><a class="btn btn-secondary btn-small" href="${ctx}/history?page=${history.number + 1}">Next →</a></c:if></div></div>
    </c:otherwise></c:choose></section>
</t:layout>
