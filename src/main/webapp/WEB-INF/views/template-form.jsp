<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Template editor"><div class="page-heading"><div><span class="greeting">GIVE PRACTICE A PURPOSE</span><h1>${empty templateId ? 'Create a test template' : 'Edit test template'}</h1><p>Time limits and question selection are always enforced on the server.</p></div><a class="btn btn-secondary" href="${ctx}/admin/test-templates">← Templates</a></div>
<%@ include file="fragments/notices.jspf" %>
<section class="panel form-panel"><form method="post" action="${ctx}/admin/test-templates${empty templateId ? '' : '/'}${templateId}"><t:csrf/><div class="form-grid">
<div class="field full"><label for="name">Test name</label><input id="name" name="name" maxlength="160" value="<c:out value='${form.name}'/>" placeholder="Quick technical warm-up" required></div><div class="field full"><label for="description">Description</label><textarea id="description" name="description" maxlength="2000" rows="3"><c:out value="${form.description}"/></textarea></div>
<div class="field"><label for="difficulty">Difficulty</label><select id="difficulty" name="difficulty"><c:forTokens items="mixed,easy,hard,basic,intermediate,advanced" delims="," var="d"><option value="${d}" ${form.difficulty == d ? 'selected' : ''}>${d}</option></c:forTokens></select><span class="field-help">Easy uses basic questions. Hard uses intermediate and advanced.</span></div><div class="field"><label for="questionCount">Number of questions</label><input id="questionCount" name="questionCount" type="number" min="1" max="100" value="${form.questionCount}" required></div>
<div class="field"><label for="durationMinutes">Duration (minutes)</label><input id="durationMinutes" name="durationMinutes" type="number" min="1" max="180" value="${form.durationMinutes}" required></div><div class="field"><label for="priceRupees">Price (INR)</label><input id="priceRupees" name="priceRupees" type="number" min="0" max="99999.99" step="0.01" value="${form.priceRupees}" required><span class="field-help">Used only when “Paid test” is checked.</span></div>
<h2 class="form-section-title">Question filters (optional)</h2><div class="field full"><label for="categoriesCsv">Categories, separated by commas</label><input id="categoriesCsv" name="categoriesCsv" maxlength="2000" value="<c:out value='${form.categoriesCsv}'/>" placeholder="Quantitative Aptitude, CSE Fundamentals"><span class="field-help">Leave blank for all categories. Names must match the question bank.</span></div><div class="field full"><label for="subcategoriesCsv">Subcategories, separated by commas</label><input id="subcategoriesCsv" name="subcategoriesCsv" maxlength="2000" value="<c:out value='${form.subcategoriesCsv}'/>"></div><div class="field full"><label for="questionTypesCsv">Question types, separated by commas</label><input id="questionTypesCsv" name="questionTypesCsv" maxlength="1000" value="<c:out value='${form.questionTypesCsv}'/>" placeholder="mcq_single, numeric, boolean"><span class="field-help">mcq_single, mcq_multiple, numeric, numeric_with_unit, data_interpretation, fraction, ratio, boolean, fill_in_blank, short_text.</span></div>
<div class="field full"><div class="inline-checks"><input type="hidden" name="_active" value="on"><label class="checkbox-label"><input type="checkbox" name="active" value="true" ${form.active ? 'checked' : ''}>Active and visible</label><input type="hidden" name="_allowReattempt" value="on"><label class="checkbox-label"><input type="checkbox" name="allowReattempt" value="true" ${form.allowReattempt ? 'checked' : ''}>Allow revision reattempts</label><input type="hidden" name="_paid" value="on"><label class="checkbox-label"><input type="checkbox" name="paid" value="true" ${form.paid ? 'checked' : ''}>Paid test</label></div></div>
</div><div class="form-actions"><a class="btn btn-secondary" href="${ctx}/admin/test-templates">Cancel</a><button class="btn" type="submit">Save template <t:icon name="check"/></button></div></form></section>
</t:layout>
