<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="My profile"><div class="narrow"><div class="page-heading"><div><span class="greeting">YOUR ACCOUNT, YOUR SPACE</span><h1>My profile</h1><p>Keep your account details up to date and your password secure.</p></div></div>
<%@ include file="fragments/notices.jspf" %>
<div class="profile-heading"><span class="avatar">${fn:toUpperCase(fn:substring(currentUser.name,0,1))}</span><div><h2><c:out value="${currentUser.name}"/></h2><p><c:out value="${currentUser.email}"/> · ${currentUser.role == 'ADMIN' ? 'Administrator' : 'Student'}</p></div></div>
<div class="split-grid"><section class="panel profile-panel"><h2>Personal details</h2><form class="form-spaced" method="post" action="${ctx}/profile"><t:csrf/><div class="field"><label for="name">Full name</label><input id="name" name="name" maxlength="100" autocomplete="name" value="<c:out value='${currentUser.name}'/>" required></div><div class="field"><label for="email">Email address</label><input id="email" type="email" value="<c:out value='${currentUser.email}'/>" readonly><span class="field-help">Your verified email is your sign-in identity and cannot be changed here.</span></div><button class="btn" type="submit">Save changes</button></form></section>
<section class="panel profile-panel"><h2>Change password</h2><form class="form-spaced" method="post" action="${ctx}/profile/password"><t:csrf/><div class="field"><label for="currentPassword">Current password</label><input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" maxlength="72" required></div><div class="field"><label for="newPassword">New password</label><input id="newPassword" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="72" required></div><div class="field"><label for="confirmPassword">Confirm new password</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="72" required></div><p class="field-help" style="margin-bottom:17px">Changing your password signs out all existing sessions.</p><button class="btn btn-secondary" type="submit">Update password</button></form></section></div></div>
</t:layout>
