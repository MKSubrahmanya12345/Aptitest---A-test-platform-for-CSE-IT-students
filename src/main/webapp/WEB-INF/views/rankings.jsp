<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Rankings">
    <div class="page-heading"><div><span class="greeting">A LITTLE HEALTHY COMPETITION</span><h1>The practice leaderboard</h1><p>Fresh, completed tests count. Revision reattempts never inflate rankings.</p></div><span class="section-index">${fn:length(rankings)} ranked students</span></div>
    <nav class="tabs" aria-label="Ranking types"><a class="tab ${sort == 'accuracy' ? 'active' : ''}" href="?sort=accuracy">Answer accuracy</a><a class="tab ${sort == 'score' ? 'active' : ''}" href="?sort=score">Total correct</a><a class="tab ${sort == 'activity' ? 'active' : ''}" href="?sort=activity">Most active</a><a class="tab ${sort == 'speed' ? 'active' : ''}" href="?sort=speed">Fastest pace</a></nav>
    <section class="panel"><c:choose><c:when test="${empty rankings}"><div class="empty-state"><t:icon name="trophy"/><h3>The first spot is up for grabs.</h3><p>Complete a fresh test and answer at least one question to join the leaderboard.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Rank</th><th>Student</th><th>Tests</th><th>Correct answers</th><th>Accuracy</th><th>Average score</th><th>Seconds / answer</th><c:if test="${currentUser.role == 'ADMIN'}"><th></th></c:if></tr></thead><tbody><c:forEach items="${rankings}" var="row" varStatus="i"><tr><td><span class="rank-number">${i.count}</span></td><td><span class="cell-title"><c:out value="${row.name}"/></span></td><td>${row.tests}</td><td>${row.totalScore}</td><td><strong>${row.accuracy}%</strong></td><td>${row.averageScore}%</td><td>${row.averageSeconds}s</td><c:if test="${currentUser.role == 'ADMIN'}"><td><a class="btn btn-secondary btn-small" href="${ctx}/admin/view-students/${row.userId}">View stats</a></td></c:if></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section><p class="field-help" style="margin-top:17px">Accuracy = correct / answered. Average score includes skipped questions. Pace = total test duration used / answered questions. Only active, verified students are ranked.</p>
</t:layout>
