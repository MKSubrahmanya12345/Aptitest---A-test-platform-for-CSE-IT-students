<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Admin overview">
<div class="page-heading"><div><div class="greeting">A HEALTHY PLATFORM STARTS HERE</div><h1>Your platform at a glance.</h1><p>Manage the question bank, publish practice tests, and follow student progress.</p></div><a class="btn" href="${ctx}/admin/questions/new">+ Create question</a></div>
<%@ include file="fragments/notices.jspf" %>
<div class="stats-grid"><div class="stat-card"><div class="stat-top">Pending review <span class="stat-icon"><t:icon name="book"/></span></div><div class="stat-value">${stats.pending}</div><p><a href="${ctx}/admin/manage-questions?status=pending">Open review queue →</a></p></div><div class="stat-card"><div class="stat-top">Live questions <span class="stat-icon"><t:icon name="check"/></span></div><div class="stat-value">${stats.active}</div><p><a href="${ctx}/admin/manage-questions?status=active">Browse approved bank →</a></p></div><div class="stat-card"><div class="stat-top">Active categories <span class="stat-icon"><t:icon name="chart"/></span></div><div class="stat-value">${stats.categoryCount}</div><p>Aptitude and technical topics</p></div><div class="stat-card"><div class="stat-top">Registered students <span class="stat-icon"><t:icon name="users"/></span></div><div class="stat-value">${stats.students}</div><p><a href="${ctx}/admin/view-students">View student accounts →</a></p></div></div>
<div class="split-grid section"><section class="panel"><div class="section-title"><div><h2>Questions by category</h2><p>Approved questions available for practice.</p></div><t:icon name="book"/></div><c:forEach items="${stats.categories}" var="entry"><div class="category-count"><span><c:out value="${entry.key}"/></span><strong>${entry.value}</strong></div></c:forEach><c:if test="${empty stats.categories}"><div class="empty-state"><p>Publish your first questions to see category coverage.</p></div></c:if></section>
<section class="panel"><div class="section-title"><div><h2>Daily practice activity</h2><p>Fresh, completed tests over the last 14 days (IST).</p></div><t:icon name="chart"/></div><c:set var="maxTrend" value="1"/><c:forEach items="${stats.trends}" var="entry"><c:if test="${entry.value > maxTrend}"><c:set var="maxTrend" value="${entry.value}"/></c:if></c:forEach><div class="trend-bars" role="img" aria-label="Daily completed test counts"><c:forEach items="${stats.trends}" var="entry"><div class="trend-day" title="${entry.key}: ${entry.value} tests"><span>${entry.value}</span><div class="trend-bar" style="height:${entry.value * 85 / maxTrend}px"></div><span>${fn:substring(entry.key,8,10)}</span></div></c:forEach></div><div class="trend-label"><span>Day of month</span><span>${stats.completed} total completed attempts, including revision</span></div></section></div>
<div class="section-title"><h2>Keep things moving</h2></div><div class="templates-grid"><a class="test-card" href="${ctx}/admin/manage-questions"><div class="card-top"><span class="card-icon"><t:icon name="check"/></span><t:icon name="arrow"/></div><h3>Review the next question</h3><p>Check correctness, add explanations, and publish with confidence.</p></a><a class="test-card" href="${ctx}/admin/test-templates"><div class="card-top"><span class="card-icon"><t:icon name="book"/></span><t:icon name="arrow"/></div><h3>Build a better practice test</h3><p>Configure the question count, time limit, difficulty, and categories.</p></a><a class="test-card" href="${ctx}/admin/rankings"><div class="card-top"><span class="card-icon"><t:icon name="trophy"/></span><t:icon name="arrow"/></div><h3>See how students are doing</h3><p>Compare accuracy, pace, activity, and correct-answer totals.</p></a></div>
</t:layout>
