<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Overview">
    <div class="page-heading"><div><div class="greeting">A GOOD DAY TO MAKE PROGRESS</div><h1>Welcome back, <c:out value="${fn:split(currentUser.name, ' ')[0]}"/> <span class="muted">✦</span></h1><p>Here's your practice journey, one step at a time.</p></div><a class="btn btn-secondary btn-small" href="${ctx}/history"><t:icon name="clock"/>View history</a></div>
    <%@ include file="fragments/notices.jspf" %>
    <c:if test="${not empty activeAttempt}"><div class="resume-banner"><div><h3>You have a test in progress.</h3><p><c:out value="${activeAttempt.templateName}"/> · Your saved answers are waiting for you.</p></div><a class="btn" href="${ctx}/tests/${activeAttempt.id}">Resume test <t:icon name="arrow"/></a></div></c:if>
    <section class="hero"><div><span class="eyebrow">YOUR FUTURE IS A WORK IN PROGRESS</span><h2>Small steps.<br>Stronger skills.</h2><p>Aptitude, reasoning, and technical practice. Find your pace, learn from every attempt, and keep moving.</p></div><div class="hero-art" aria-hidden="true"><div class="hero-tile"><t:icon name="trophy"/><strong>Your next step</strong><span>Better than yesterday.</span></div><div class="hero-tile"><t:icon name="book"/><strong>Practice</strong><div class="tiny-line"></div></div><div class="hero-tile"><t:icon name="chart"/><strong>Review &amp; improve</strong><span>Progress, not perfection.</span></div></div></section>
    <%@ include file="fragments/student-stats.jspf" %>
    <section class="section" id="practice"><div class="section-title"><div><h2>Make time for practice</h2><p>Choose a test that fits your goals and your day.</p></div><span class="section-index">${fn:length(templates)} tests available</span></div>
    <div class="templates-grid"><c:forEach items="${templates}" var="test">
        <c:set var="unlocked" value="${not test.paid or accessIds.contains(test.id)}"/>
        <article class="test-card card-${test.difficulty}"><div class="card-top"><span class="card-icon"><t:icon name="${test.difficulty == 'hard' ? 'trophy' : 'book'}"/></span><span class="pill ${test.difficulty == 'hard' ? 'pill-purple' : test.difficulty == 'mixed' ? 'pill-muted' : ''}">${test.difficulty == 'hard' ? 'Challenge' : test.difficulty == 'mixed' ? 'Mixed practice' : 'Foundation'}</span></div><h3><c:out value="${test.name}"/></h3><p><c:out value="${test.description}"/></p><div class="test-meta"><span><t:icon name="book"/>${test.questionCount} questions</span><span><t:icon name="clock"/>${test.durationMinutes} min</span></div>
        <div class="card-footer"><span>${available[test.id]} matching questions</span><strong>${test.paid ? test.priceDisplay : 'Free practice'}</strong></div>
        <c:choose><c:when test="${unlocked}"><form method="post" action="${ctx}/tests/start"><t:csrf/><input type="hidden" name="templateId" value="${test.id}"><details class="test-settings"><summary>Practice options</summary><div class="checkbox-list"><span class="field-help">All topics are used unless you select specific ones.</span><c:forEach items="${categories}" var="topic"><label class="checkbox-label"><input type="checkbox" name="categories" value="<c:out value='${topic}'/>"><c:out value="${topic}"/></label></c:forEach></div><label class="checkbox-label"><input type="checkbox" name="includeSeen" value="true">Allow previously viewed questions</label></details><button class="btn btn-block" type="submit" ${available[test.id] lt test.questionCount ? 'disabled' : ''}>Start practice <t:icon name="arrow"/></button></form></c:when><c:otherwise><a class="btn btn-soft btn-block" href="${ctx}/checkout/${test.id}">${demoEnabled ? 'Unlock with demo checkout' : 'Unlock this test'} <t:icon name="arrow"/></a></c:otherwise></c:choose>
        </article>
    </c:forEach></div><c:if test="${empty templates}"><div class="panel empty-state"><h3>No tests published yet.</h3><p>Your administrator can create and activate test templates.</p></div></c:if></section>
    <div class="split-grid section"><section class="panel"><div class="section-title"><div><h2>Your topic breakdown</h2><p>A clearer picture of your strengths.</p></div><t:icon name="chart"/></div><%@ include file="fragments/performance.jspf" %></section>
    <section class="panel"><div class="section-title"><div><h2>Recent activity</h2><p>A look at your latest practice.</p></div><a href="${ctx}/history">View all →</a></div><c:choose><c:when test="${empty recent}"><div class="empty-state"><t:icon name="clock"/><h3>A fresh page. A fresh start.</h3><p>Your recent tests will appear here. Pick a warm-up test to get going.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Practice test</th><th>Score</th><th></th></tr></thead><tbody><c:forEach items="${recent}" var="a"><tr><td><span class="cell-title"><c:out value="${a.templateName}"/></span><span class="cell-subtitle">${a.displayDate}${a.reattempt ? ' · Reattempt' : ''}</span></td><td><c:choose><c:when test="${a.completed}"><strong>${a.percentage}%</strong></c:when><c:otherwise><span class="pill pill-amber">In progress</span></c:otherwise></c:choose></td><td><a href="${ctx}/tests/${a.id}${a.completed ? '/result' : ''}" aria-label="${a.completed ? 'Review result' : 'Resume test'}"><t:icon name="arrow"/></a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></div>
    <p class="field-help">Reattempts are for revision only and do not change your statistics or rankings. Test times are enforced by the server. Dates are shown in India Standard Time.</p>
</t:layout>
