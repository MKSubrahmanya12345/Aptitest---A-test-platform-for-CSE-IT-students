<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Question editor"><div class="page-heading"><div><span class="greeting">GOOD PRACTICE STARTS WITH GOOD QUESTIONS</span><h1>${empty questionId ? 'Create a question' : 'Edit question'}</h1><p>Structured answers make grading consistent. All content is displayed as safe plain text.</p></div><a class="btn btn-secondary" href="${ctx}/admin/manage-questions">← Question bank</a></div>
<%@ include file="fragments/notices.jspf" %>
<section class="panel form-panel"><form method="post" action="${ctx}/admin/questions${empty questionId ? '' : '/'}${questionId}"><t:csrf/><div class="form-grid">
<div class="field"><label for="category">Category</label><input id="category" name="category" maxlength="100" value="<c:out value='${form.category}'/>" placeholder="Quantitative Aptitude" required></div><div class="field"><label for="subcategory">Subcategory</label><input id="subcategory" name="subcategory" maxlength="100" value="<c:out value='${form.subcategory}'/>" placeholder="Percentages"></div>
<div class="field"><label for="difficulty">Difficulty</label><select id="difficulty" name="difficulty"><c:forTokens items="basic,intermediate,advanced" delims="," var="d"><option value="${d}" ${form.difficulty == d ? 'selected' : ''}>${d}</option></c:forTokens></select></div><div class="field"><label for="questionType">Question type</label><select id="questionType" name="questionType"><c:forTokens items="mcq_single,mcq_multiple,numeric,numeric_with_unit,data_interpretation,fraction,ratio,boolean,fill_in_blank,short_text" delims="," var="type"><option value="${type}" ${form.questionType == type ? 'selected' : ''}>${fn:replace(type,'_',' ')}</option></c:forTokens></select></div>
<div class="field full"><label for="questionText">Question text</label><textarea id="questionText" name="questionText" rows="4" maxlength="20000" required><c:out value="${form.questionText}"/></textarea></div><div class="field full"><label for="passage">Passage (optional)</label><textarea id="passage" name="passage" rows="3" maxlength="20000"><c:out value="${form.passage}"/></textarea></div><div class="field full"><label for="dataBlock">Data / table description (optional)</label><textarea id="dataBlock" name="dataBlock" rows="3" maxlength="20000"><c:out value="${form.dataBlock}"/></textarea><span class="field-help">Plain text or JSON, rendered without interpreting HTML.</span></div>
<h2 class="form-section-title">Answer &amp; grading</h2>
<div class="field full"><label for="optionsJson">Options (JSON object or array)</label><textarea class="code-input" id="optionsJson" name="optionsJson" rows="3" maxlength="20000"><c:out value="${form.optionsJson}"/></textarea><span class="field-help">For MCQs: {"A":"First choice","B":"Second choice"}. For non-MCQs use {}.</span></div><div class="field"><label for="correctAnswerJson">Correct answer (JSON object)</label><textarea class="code-input" id="correctAnswerJson" name="correctAnswerJson" rows="3" maxlength="20000" required><c:out value="${form.correctAnswerJson}"/></textarea></div><div class="field"><label for="gradingConfigJson">Grading configuration (JSON object)</label><textarea class="code-input" id="gradingConfigJson" name="gradingConfigJson" rows="3" maxlength="2000"><c:out value="${form.gradingConfigJson}"/></textarea></div>
<div class="field full"><label for="solution">Explanation</label><textarea id="solution" name="solution" rows="4" maxlength="10000"><c:out value="${form.solution}"/></textarea><span class="field-help">Students see this only after submitting the test.</span></div><div class="field"><label for="status">Publication status</label><select id="status" name="status"><c:forTokens items="pending,active,inactive,rejected" delims="," var="state"><option value="${state}" ${form.status == state ? 'selected' : ''}>${state}</option></c:forTokens></select></div></div><div class="form-actions"><a class="btn btn-secondary" href="${ctx}/admin/manage-questions">Cancel</a><button class="btn" type="submit">Save question <t:icon name="check"/></button></div></form>
<div class="code-help"><strong>Answer examples</strong><br>Single choice: <code>{"value":"A"}</code> · Multiple choice: <code>{"values":["A","C"]}</code><br>Number: <code>{"value":42}</code> · With unit: <code>{"value":50,"unit":"km/h"}</code><br>Fraction: <code>{"numerator":1,"denominator":2}</code> · Ratio: <code>{"values":[2,3]}</code><br>Boolean: <code>{"value":true}</code> · Text: <code>{"answers":["new","NEW"]}</code><br><strong>Optional grading settings</strong><br><code>{"tolerance":0.01,"unit_required":true,"allow_decimal_equivalent":true,"allow_scaled_equivalent":true,"case_sensitive":false,"ignore_punctuation":true,"trim_spaces":true}</code><br>Only settings relevant to the selected type are used. Live sessions use immutable snapshots, so editing does not change earlier tests.</div></section>
</t:layout>
