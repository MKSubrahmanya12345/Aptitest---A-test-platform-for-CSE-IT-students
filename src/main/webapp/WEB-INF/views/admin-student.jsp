<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Student details"><div class="page-heading"><div><span class="greeting">AN INDIVIDUAL VIEW OF PROGRESS</span><h1><c:out value="${student.name}"/></h1><p><c:out value="${student.email}"/> · Student #${student.id}</p></div><a class="btn btn-secondary" href="${ctx}/admin/view-students">← Students</a></div>
<%@ include file="fragments/notices.jspf" %>
<div class="section-title"><span class="pill ${student.enabled ? '' : 'pill-red'}">${student.enabled ? 'Active account' : 'Disabled account'}</span><form method="post" action="${ctx}/admin/view-students/${student.id}/status" data-confirm="Change this student's access? Existing sessions will be revoked."><t:csrf/><input type="hidden" name="enabled" value="${not student.enabled}"><button class="btn ${student.enabled ? 'btn-secondary' : ''} btn-small" type="submit">${student.enabled ? 'Disable account' : 'Enable account'}</button></form></div>
<%@ include file="fragments/student-stats.jspf" %>
<section class="panel section"><div class="section-title"><h2>Topic performance</h2></div><%@ include file="fragments/performance.jspf" %></section>
<section class="panel"><div class="section-title"><div><h2>Practice history</h2><p>${history.totalElements} attempts, including revision and active sessions.</p></div></div><c:choose><c:when test="${empty history.content}"><div class="empty-state"><p>This student has not started a test yet.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Test</th><th>Started (IST)</th><th>Score</th><th>Status</th><th></th></tr></thead><tbody><c:forEach items="${history.content}" var="a"><tr><td><span class="cell-title"><c:out value="${a.templateName}"/></span><c:if test="${a.reattempt}"><span class="cell-subtitle">Revision · not counted in stats</span></c:if></td><td>${a.displayDate}</td><td>${a.completed ? a.percentage : '—'}${a.completed ? '%' : ''}</td><td><span class="pill ${a.completed ? '' : 'pill-amber'}">${a.completed ? 'Completed' : 'In progress'}</span></td><td><c:if test="${a.completed}"><a class="btn btn-secondary btn-small" href="${ctx}/admin/attempts/${a.id}">Review result</a></c:if></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose><div class="pagination"><span>Page ${history.number+1} of ${history.totalPages == 0 ? 1 : history.totalPages}</span><div><c:if test="${not history.first}"><a class="btn btn-secondary btn-small" href="?page=${history.number-1}">← Previous</a></c:if><c:if test="${not history.last}"><a class="btn btn-secondary btn-small" href="?page=${history.number+1}">Next →</a></c:if></div></div></section>
</t:layout>
