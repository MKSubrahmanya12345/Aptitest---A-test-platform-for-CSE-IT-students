<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Practice test">
    <div class="page-heading"><div><span class="greeting">STAY FOCUSED. YOU'VE GOT THIS.</span><h1><c:out value="${attempt.templateName}"/></h1><p>Question ${item.position} of ${attempt.totalQuestions} · Answers are saved as you go.</p></div><span class="pill ${attempt.reattempt ? 'pill-purple' : ''}">${attempt.reattempt ? 'Revision reattempt' : 'Fresh attempt'}</span></div>
    <%@ include file="fragments/notices.jspf" %>
    <div class="quiz-layout"><section class="panel">
        <div class="quiz-heading"><span class="pill pill-muted"><c:out value="${item.category}"/></span><span class="field-help"><c:out value="${fn:replace(item.questionType, '_', ' ')}"/></span></div>
        <c:if test="${not empty item.passage}"><div class="quiz-passage"><c:out value="${item.passage}"/></div></c:if>
        <c:if test="${not empty item.dataBlock}"><div class="quiz-data"><c:out value="${item.dataBlock}"/></div></c:if>
        <h2 class="quiz-question"><c:out value="${item.questionText}"/></h2>
        <form id="answer-form" method="post" action="${ctx}/tests/${attempt.id}/answer" data-answer-form data-autosave="${ctx}/tests/${attempt.id}/autosave" data-result="${ctx}/tests/${attempt.id}/result"><t:csrf/><input type="hidden" name="position" value="${item.position}">
        <c:choose><c:when test="${item.questionType == 'mcq_single' or item.questionType == 'mcq_multiple'}">
            <c:if test="${item.multipleChoice}"><p class="field-help" style="margin-bottom:12px">Select all correct options. All selections must match for a mark.</p></c:if>
            <div class="quiz-options"><c:forEach items="${item.optionMap}" var="option"><label class="quiz-option"><input type="${item.multipleChoice ? 'checkbox' : 'radio'}" name="answer" value="<c:out value='${option.key}'/>" ${item.selectedOptions.contains(option.key) ? 'checked' : ''}><span class="option-label"><c:out value="${option.key}"/></span><span><c:out value="${option.value}"/></span></label></c:forEach></div>
        </c:when><c:when test="${item.questionType == 'boolean'}"><div class="quiz-options"><label class="quiz-option"><input type="radio" name="answer" value="true" ${item.userAnswer == 'true' ? 'checked' : ''}>True</label><label class="quiz-option"><input type="radio" name="answer" value="false" ${item.userAnswer == 'false' ? 'checked' : ''}>False</label></div></c:when>
        <c:otherwise><div class="field"><label for="answer">Your answer</label><input id="answer" name="answer" type="text" maxlength="2000" autocomplete="off" placeholder="Type your answer here" value="<c:out value='${item.userAnswer}'/>"><span class="field-help"><c:choose><c:when test="${item.questionType == 'fraction'}">Use numerator/denominator, for example 1/2. Equivalent fractions are accepted.</c:when><c:when test="${item.questionType == 'ratio'}">Use colon-separated terms, for example 2:3 or 1:2:3.</c:when><c:when test="${item.questionType == 'numeric_with_unit'}">Include the requested unit, for example 50 km/h.</c:when><c:when test="${item.questionType == 'numeric'}">Enter a number. Negative numbers and decimals are supported.</c:when><c:otherwise>Enter a concise answer in your own words.</c:otherwise></c:choose></span></div></c:otherwise></c:choose>
        <div class="quiz-check"><label class="checkbox-label"><input type="checkbox" name="flagged" value="true" ${item.flagged ? 'checked' : ''}>Mark this question for review</label></div>
        <div class="quiz-actions"><button type="button" class="btn btn-secondary btn-small" data-clear-answer>Clear answer</button><div><c:if test="${item.position > 1}"><button type="submit" class="btn btn-secondary" name="navigation" value="previous">← Previous</button></c:if><c:choose><c:when test="${item.position < attempt.totalQuestions}"><button type="submit" class="btn" name="navigation" value="next">Save &amp; next <t:icon name="arrow"/></button></c:when><c:otherwise><button type="submit" class="btn" name="navigation" value="finish">Save &amp; finish test <t:icon name="check"/></button></c:otherwise></c:choose></div></div><p class="save-status" data-save-status role="status">Your saved answers survive refreshes and reconnects.</p>
        </form>
    </section>
    <aside class="panel quiz-side"><div class="quiz-timer"><span>TIME REMAINING</span><strong data-deadline="${attempt.expiresAt}" role="timer">--:--</strong></div><h3>Question navigator</h3><p class="field-help">${answered} of ${attempt.totalQuestions} answered</p><nav class="question-nav" aria-label="Question navigation"><c:forEach items="${items}" var="q"><a href="${ctx}/tests/${attempt.id}?q=${q.position}" data-test-navigation data-question-number="${q.position}" class="${q.answered ? 'answered' : ''} ${q.flagged ? 'flagged' : ''} ${q.position == item.position ? 'current' : ''}" aria-label="Question ${q.position}${q.answered ? ', answered' : ''}${q.flagged ? ', flagged' : ''}" ${q.position == item.position ? 'aria-current="step"' : ''}>${q.position}</a></c:forEach></nav><div class="nav-legend"><span><i class="legend-square"></i>Answered</span><span><i class="legend-square amber"></i>For review</span></div><form id="finish-form" data-finish-form method="post" action="${ctx}/tests/${attempt.id}/submit"><t:csrf/><button type="submit" class="btn btn-block btn-secondary">Submit test</button></form><p class="field-help" style="margin-top:14px">The server automatically submits when time runs out. No negative marking. With JavaScript disabled, use Save &amp; next to persist answers.</p></aside></div>
</t:layout>
