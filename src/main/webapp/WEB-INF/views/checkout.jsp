<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Unlock test"><section class="panel checkout-card"><span class="card-icon"><t:icon name="trophy"/></span><span class="greeting">INVEST IN YOUR NEXT STEP</span><h1><c:out value="${template.name}"/></h1><p><c:out value="${template.description}"/></p><div class="checkout-price">${template.priceDisplay}</div><div class="checkout-details"><span>${template.questionCount} questions</span><span>${template.durationMinutes} minutes</span><span>One-time unlock</span></div>
<c:choose><c:when test="${paymentMode == 'demo'}"><div class="notice info">Demo checkout only. No bank details are requested, no gateway is contacted, and no real money is charged.</div><form method="post" action="${ctx}/checkout/${template.id}/demo"><t:csrf/><input type="hidden" name="orderId" value="<c:out value='${order.orderId}'/>"><button class="btn btn-block" type="submit">Grant demo access — no charge <t:icon name="arrow"/></button></form></c:when><c:otherwise>
<button class="btn btn-block" type="button" data-razorpay-checkout data-key="<c:out value='${razorpayKeyId}'/>" data-amount="${order.amountPaise}" data-description="<c:out value='${template.name}'/>" data-order="<c:out value='${order.orderId}'/>" data-name="<c:out value='${currentUser.name}'/>" data-email="<c:out value='${currentUser.email}'/>">Pay securely with Razorpay <t:icon name="arrow"/></button><script src="https://checkout.razorpay.com/v1/checkout.js" defer></script>
<form method="post" action="${ctx}/checkout/${template.id}/verify" data-payment-verify><t:csrf/><input type="hidden" name="orderId" value="<c:out value='${order.orderId}'/>"><input type="hidden" name="paymentId"><input type="hidden" name="signature"></form><p class="field-help">Access is granted only after server-side signature and captured-payment verification.</p><noscript>Enable JavaScript to use the payment gateway.</noscript>
</c:otherwise></c:choose><p data-checkout-status role="alert"></p><a class="btn btn-secondary btn-block" href="${ctx}/dashboard">← Back to practice</a></section></t:layout>
