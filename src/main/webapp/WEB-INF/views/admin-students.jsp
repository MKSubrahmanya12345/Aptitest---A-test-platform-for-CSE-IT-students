<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Students"><div class="page-heading"><div><span class="greeting">PEOPLE BEHIND THE PROGRESS</span><h1>Your student community</h1><p>Review accounts, explore practice history, and manage access.</p></div><span class="section-index">${total} students</span></div>
<%@ include file="fragments/notices.jspf" %>
<form class="filters" method="get" action="${ctx}/admin/view-students"><input type="search" name="search" value="<c:out value='${search}'/>" placeholder="Search by name or email" aria-label="Search students"><button class="btn" type="submit">Search students</button></form>
<section class="panel"><c:choose><c:when test="${empty students}"><div class="empty-state"><t:icon name="users"/><h3>No students found.</h3><p>New student registrations will appear here.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Student</th><th>Email</th><th>Verification</th><th>Account status</th><th></th></tr></thead><tbody><c:forEach items="${students}" var="student"><tr><td><span class="cell-title"><c:out value="${student.name}"/></span><span class="cell-subtitle">Student #${student.id}</span></td><td><c:out value="${student.email}"/></td><td><span class="pill ${student.emailVerified ? '' : 'pill-amber'}">${student.emailVerified ? 'Verified' : 'Unverified'}</span></td><td><span class="pill ${student.enabled ? '' : 'pill-red'}">${student.enabled ? 'Active' : 'Disabled'}</span></td><td><a class="btn btn-secondary btn-small" href="${ctx}/admin/view-students/${student.id}">View profile &amp; stats →</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<div class="pagination"><span>Page ${page+1} of ${pages}</span><div><c:if test="${page > 0}"><c:url var="prev" value="/admin/view-students"><c:param name="page" value="${page-1}"/><c:param name="search" value="${search}"/></c:url><a class="btn btn-secondary btn-small" href="<c:out value='${prev}'/>">← Previous</a></c:if><c:if test="${page+1 < pages}"><c:url var="next" value="/admin/view-students"><c:param name="page" value="${page+1}"/><c:param name="search" value="${search}"/></c:url><a class="btn btn-secondary btn-small" href="<c:out value='${next}'/>">Next →</a></c:if></div></div></section>
</t:layout>
