<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Test result">
    <div class="page-heading"><div><span class="greeting">ANOTHER STEP FORWARD</span><h1>Your practice, in perspective.</h1><p><c:out value="${attempt.templateName}"/> · ${attempt.displayDate} IST</p></div><div class="section-actions no-print"><a class="btn btn-secondary btn-small" href="${ctx}${backUrl}">← Back</a><button type="button" class="btn btn-secondary btn-small" data-print>Print result</button></div></div>
    <div class="result-hero"><div class="score-ring"><strong>${attempt.percentage}%</strong><span>YOUR SCORE</span></div><div><span class="pill">${attempt.reattempt ? 'REVISION COMPLETE' : 'PRACTICE COMPLETE'}</span><h2>${attempt.percentage >= 80 ? 'Looking sharp. Keep it up.' : attempt.percentage >= 50 ? 'Good progress. Keep growing.' : 'Every attempt is a chance to learn.'}</h2><p>${attempt.correctCount} correct answers out of ${attempt.totalQuestions}. Take a moment to review your thinking.</p></div></div>
    <c:if test="${attempt.reattempt}"><div class="notice info">This was a revision reattempt. It has not changed your dashboard statistics or rankings.</div></c:if>
    <div class="stats-grid"><div class="stat-card"><div class="stat-top">Correct <span class="stat-icon"><t:icon name="check"/></span></div><div class="stat-value">${attempt.correctCount}</div><p>One mark per correct answer</p></div><div class="stat-card"><div class="stat-top">Incorrect <span class="stat-icon"><t:icon name="book"/></span></div><div class="stat-value">${attempt.wrongCount}</div><p>An opportunity to learn</p></div><div class="stat-card"><div class="stat-top">Skipped <span class="stat-icon"><t:icon name="arrow"/></span></div><div class="stat-value">${attempt.skippedCount}</div><p>No negative marking</p></div><div class="stat-card"><div class="stat-top">Time used <span class="stat-icon"><t:icon name="clock"/></span></div><div class="stat-value"><fmt:formatNumber value="${attempt.elapsedSeconds / 60}" maxFractionDigits="1"/><small> min</small></div><p>Of ${attempt.durationSeconds / 60} minutes available</p></div></div>
    <div class="section-title"><div><h2>Review &amp; learn</h2><p>Your answers, the expected answers, and the reasoning.</p></div><c:if test="${currentUser.role == 'STUDENT' and attempt.allowReattempt}"><form class="no-print" method="post" action="${ctx}/tests/${attempt.id}/reattempt"><t:csrf/><button class="btn btn-soft btn-small" type="submit">Try these questions again <t:icon name="arrow"/></button></form></c:if></div>
    <c:forEach items="${items}" var="item"><%@ include file="fragments/review-question.jspf" %></c:forEach>
</t:layout>
