<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Email outbox"><div class="page-heading"><div><span class="greeting">ACCOUNT MANAGEMENT</span><h1>Email outbox</h1><p>Account verification and password-reset messages. Only administrators can access this page.</p></div></div>
<div class="notice info">Outbox delivery is enabled. Messages are retained here rather than emailed externally. Configure SendGrid to send email. Links expire and can be used only once.</div>
<section class="panel"><c:choose><c:when test="${empty messages}"><div class="empty-state"><t:icon name="book"/><h3>The outbox is empty.</h3><p>New account and password-recovery messages will appear here.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Recipient</th><th>Subject</th><th>Created (UTC)</th><th>Action</th></tr></thead><tbody><c:forEach items="${messages}" var="mail"><tr><td><c:out value="${mail.recipient}"/></td><td><c:out value="${mail.subject}"/></td><td><c:out value="${mail.createdAt}"/></td><td><a class="btn btn-secondary btn-small" href="${ctx}<c:out value='${mail.path}'/>">Open account link →</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></t:layout>
