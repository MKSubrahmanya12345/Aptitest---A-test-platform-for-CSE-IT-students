<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Demo email outbox"><div class="page-heading"><div><span class="greeting">FOR LOCAL DEMONSTRATIONS ONLY</span><h1>Demo email outbox</h1><p>Verification and reset links generated since this application started. Only administrators can view them.</p></div></div><div class="notice info">No external email has been sent. This outbox is in memory and is disabled outside demo mode. Tokens are single-use, expiring, and stored as hashes in the database.</div>
<section class="panel"><c:choose><c:when test="${empty messages}"><div class="empty-state"><t:icon name="book"/><h3>The outbox is empty.</h3><p>Register an account or request a password reset to generate a demonstration email.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Recipient</th><th>Subject</th><th>Created (UTC)</th><th>Link</th></tr></thead><tbody><c:forEach items="${messages}" var="mail"><tr><td><c:out value="${mail.recipient}"/></td><td><c:out value="${mail.subject}"/></td><td><c:out value="${mail.createdAt}"/></td><td><a class="btn btn-secondary btn-small" href="${ctx}<c:out value='${mail.path}'/>">Open demonstration link →</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></t:layout>
