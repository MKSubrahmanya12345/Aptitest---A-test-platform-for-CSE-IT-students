<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/taglibs.jspf" %>
<t:layout title="Question bank">
<div class="page-heading"><div><span class="greeting">QUALITY QUESTIONS. BETTER PRACTICE.</span><h1>Your question bank</h1><p>Review imported questions, keep answers accurate, and build a useful practice library.</p></div><a class="btn" href="${ctx}/admin/questions/new">+ Create question</a></div>
<%@ include file="fragments/notices.jspf" %>
<nav class="tabs" aria-label="Question status"><c:forTokens items="pending,active,inactive,rejected" delims="," var="tab"><a class="tab ${status == tab ? 'active' : ''}" href="?status=${tab}">${tab == 'pending' ? 'Pending review' : tab == 'active' ? 'Live approved' : tab == 'inactive' ? 'Inactive' : 'Rejected'}</a></c:forTokens><a class="tab ${empty status ? 'active' : ''}" href="?status=">All questions</a></nav>
<form class="filters" method="get" action="${ctx}/admin/manage-questions"><input type="hidden" name="status" value="<c:out value='${status}'/>"><input type="search" name="search" value="<c:out value='${search}'/>" placeholder="Search question text" aria-label="Search question text"><select name="category" aria-label="Category"><option value="">All categories</option><c:forEach items="${categories}" var="cat"><option value="<c:out value='${cat}'/>" ${cat == category ? 'selected' : ''}><c:out value="${cat}"/></option></c:forEach></select><button class="btn" type="submit">Filter questions</button></form>
<c:if test="${status == 'pending'}"><div class="notice info">Flagged questions from the original reports are intentionally unpublished. MCQs without choices must be edited before they can be approved.</div></c:if>
<section class="panel"><c:choose><c:when test="${empty questions.content}"><div class="empty-state"><t:icon name="check"/><h3>Nothing in this view.</h3><p>Try another status, change the filter, or create a new question.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>ID</th><th>Question</th><th>Category / difficulty</th><th>Type</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach items="${questions.content}" var="q"><tr><td class="muted">#${q.id}</td><td class="question-cell"><span class="question-preview"><c:out value="${q.questionText}"/></span><span class="cell-subtitle"><c:out value="${q.sourceRef}"/></span></td><td><span class="cell-title"><c:out value="${q.category}"/></span><span class="cell-subtitle"><c:out value="${q.difficulty}"/></span></td><td class="muted"><c:out value="${q.questionType}"/></td><td><span class="pill ${q.status == 'pending' ? 'pill-amber' : q.status == 'rejected' ? 'pill-red' : q.status == 'inactive' ? 'pill-muted' : ''}"><c:out value="${q.status}"/></span></td><td><div class="table-actions"><a class="btn btn-secondary btn-small" href="${ctx}/admin/questions/${q.id}/edit">Edit</a><c:if test="${q.status == 'pending'}"><form method="post" action="${ctx}/admin/questions/${q.id}/review" data-confirm="Apply this review decision?"><t:csrf/><button class="btn btn-soft btn-small" type="submit" name="decision" value="approve">Approve</button><button class="btn btn-secondary btn-small" type="submit" name="decision" value="reject">Reject</button></form></c:if></div></td></tr></c:forEach></tbody></table></div>
<div class="pagination"><span>${questions.totalElements} questions · Page ${questions.number+1} of ${questions.totalPages}</span><div><c:if test="${not questions.first}"><c:url var="prev" value="/admin/manage-questions"><c:param name="page" value="${questions.number-1}"/><c:param name="status" value="${status}"/><c:param name="search" value="${search}"/><c:param name="category" value="${category}"/></c:url><a class="btn btn-secondary btn-small" href="<c:out value='${prev}'/>">← Previous</a></c:if><c:if test="${not questions.last}"><c:url var="next" value="/admin/manage-questions"><c:param name="page" value="${questions.number+1}"/><c:param name="status" value="${status}"/><c:param name="search" value="${search}"/><c:param name="category" value="${category}"/></c:url><a class="btn btn-secondary btn-small" href="<c:out value='${next}'/>">Next →</a></c:if></div></div></c:otherwise></c:choose></section>
<details class="upload-box"><summary>Import questions from the original platform (JSON)</summary><p>Upload a JSON array, up to 500 rows and 2 MB. All rows are validated and added to the review queue together. Existing rows are not overwritten. <a href="${ctx}/examples/questions.json" download>Download an example</a>.</p><form class="upload-form" method="post" enctype="multipart/form-data" action="${ctx}/admin/questions/import"><t:csrf/><input name="file" type="file" accept="application/json,.json" aria-label="Questions JSON file" required><button class="btn btn-secondary" type="submit">Import for review</button></form></details>
</t:layout>
