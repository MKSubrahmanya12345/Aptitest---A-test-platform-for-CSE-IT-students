name: Java submission checks
on:
  push:
    branches: [arena/dcb10645-aptitest-a-test-platform-for-c]
  pull_request:
  workflow_dispatch:
defaults:
  run:
    shell: bash
permissions:
  contents: read
  checks: write
jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: maven
      - name: Compile, test and package the executable WAR
        run: ./mvnw -B --no-transfer-progress verify 2>&1 | tee build-ci.log
      - name: Exercise the packaged application and compile all JSPs
        run: python3 scripts/smoke_test.py --war target/aptitest.war 2>&1 | tee smoke-ci.log
      - name: Create source submission ZIP
        run: python3 scripts/package_submission.py
      - name: Publish build diagnostics
        if: always()
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
          CI_JOB_STATUS: ${{ job.status }}
        run: python3 scripts/ci_report.py
      - name: Upload executable and source submission
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: aptitest-java-submission
          path: |
            target/aptitest.war
            target/aptitest-submission.zip
            target/surefire-reports/
            target/smoke-server.log
          retention-days: 14
